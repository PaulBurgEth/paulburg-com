                        fontWeight: 600,
                        fontSize: 13,
                        letterSpacing: "0.04em",
                        padding: "11px 20px",
                        borderRadius: 5,
                        textDecoration: "none",
                      }
                    : {
                        display: "flex",
                        alignItems: "center",
                        justifyContent: "center",
                        background: "transparent",
                        border: "1px solid var(--c-border2)",
                        color: "var(--c-text)",
                        fontFamily: "var(--font-instrument-sans), sans-serif",
                        fontWeight: 600,
                        fontSize: 13,
                        letterSpacing: "0.04em",
                        padding: "11px 20px",
