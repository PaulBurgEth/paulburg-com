# Telegram notifications for the intake form (app/api/intake/route.ts).
# Without both of these the route answers 500 and the form reports a failure.
#
# TELEGRAM_BOT_TOKEN — from @BotFather, format 123456789:AA...
# TELEGRAM_CHAT_ID   — the chat the notifications go to; for a private chat,
#                      message the bot once and read it from
#                      https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
