"use client";

import { useState } from "react";
import { useLanguage } from "@/context/LanguageContext";

const en = {
  sectionLabel: "Intake",
  h2: "Discuss your project",
  subtitle:
    "Tell me what you need. I'll reply within 24 hours with a plan and a quote.",
  labels: {
    name: "Your name",
    business: "Business type",
    need: "What do you need?",
    budget: "Budget range",
    contactMethod: "Preferred contact",
    contactInfo: "Contact info",
  },
  needOptions: [
    { v: "bot", l: "AI Bot" },
    { v: "automation", l: "Process Automation" },
    { v: "crm", l: "Custom CRM" },
    { v: "website", l: "Custom Website" },
    { v: "turnkey", l: "Turnkey (Website + Bot + CRM)" },
    { v: "other", l: "Other" },
  ],
  budgetOptions: [
    { v: "<1k", l: "Less than $1,000" },
    { v: "1-3k", l: "$1,000 – $3,000" },
    { v: "3-10k", l: "$3,000 – $10,000" },
    { v: "10k+", l: "$10,000+" },
  ],
  contactOptions: [
    { v: "telegram", l: "Telegram" },
    { v: "whatsapp", l: "WhatsApp" },
    { v: "email", l: "Email" },
  ],
  placeholders: {
    telegram: "@username",
    whatsapp: "+66 95 627 1926",
    email: "you@example.com",
    business: "Real estate, clinic, SaaS, e-commerce…",
  },
  submit: "Send →",
  sending: "Sending…",
  success: "Thanks — I'll get back to you within 24h.",
  error: "Something went wrong. Please try Telegram instead.",
};

const ru = {
  sectionLabel: "Заявка",
  h2: "Обсудить проект",
  subtitle:
    "Расскажите, что нужно. Отвечу в течение 24 часов с планом и ценой.",
  labels: {
    name: "Ваше имя",
    business: "Тип бизнеса",
    need: "Что нужно?",
    budget: "Бюджет",
    contactMethod: "Удобный способ связи",
    contactInfo: "Контакт",
  },
  needOptions: [
    { v: "bot", l: "AI-бот" },
    { v: "automation", l: "Автоматизация процессов" },
    { v: "crm", l: "Кастомная CRM" },
    { v: "website", l: "Сайт на заказ" },
    { v: "turnkey", l: "Turnkey (Сайт + Бот + CRM)" },
    { v: "other", l: "Другое" },
  ],
  budgetOptions: [
    { v: "<1k", l: "Менее $1,000" },
    { v: "1-3k", l: "$1,000 – $3,000" },
    { v: "3-10k", l: "$3,000 – $10,000" },
    { v: "10k+", l: "$10,000+" },
  ],
  contactOptions: [
    { v: "telegram", l: "Telegram" },
    { v: "whatsapp", l: "WhatsApp" },
    { v: "email", l: "Email" },
  ],
  placeholders: {
    telegram: "@username",
    whatsapp: "+66 95 627 1926",
    email: "you@example.com",
    business: "Недвижимость, клиника, SaaS, e-commerce…",
  },
  submit: "Отправить →",
  sending: "Отправка…",
  success: "Спасибо — отвечу в течение 24 часов.",
  error: "Что-то пошло не так. Напишите мне в Telegram.",
};

type Status = "idle" | "pending" | "success" | "error";

type Props = {
  id?: string;
};

export default function IntakeForm({ id = "intake" }: Props) {
  const { language } = useLanguage();
  const t = language === "ru" ? ru : en;

  const [name, setName] = useState("");
  const [business, setBusiness] = useState("");
  const [need, setNeed] = useState("bot");
  const [budget, setBudget] = useState("1-3k");
  const [contactMethod, setContactMethod] = useState<
    "telegram" | "whatsapp" | "email"
  >("telegram");
  const [contactInfo, setContactInfo] = useState("");
  const [status, setStatus] = useState<Status>("idle");

  const contactPlaceholder =
    contactMethod === "telegram"
      ? t.placeholders.telegram
      : contactMethod === "whatsapp"
        ? t.placeholders.whatsapp
        : t.placeholders.email;

  async function handleSubmit(e: React.FormEvent) {
    e.preventDefault();
    if (status === "pending") return;
    setStatus("pending");
    try {
      const res = await fetch("/api/intake", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name,
          business,
          need,
          budget,
          contactMethod,
          contactInfo,
          language,
        }),
      });
      if (!res.ok) throw new Error("bad status");
      setStatus("success");
      setName("");
      setBusiness("");
      setContactInfo("");
    } catch {
      setStatus("error");
    }
  }

  const inputStyle: React.CSSProperties = {
    width: "100%",
    background: "rgba(255,255,255,0.02)",
    border: "1px solid var(--c-border)",
    borderRadius: 6,
    padding: "10px 12px",
    fontFamily: "var(--font-instrument-sans), sans-serif",
    fontSize: 13,
    color: "var(--c-text)",
    outline: "none",
  };

  const labelStyle: React.CSSProperties = {
    display: "block",
    fontFamily: "var(--font-inconsolata), monospace",
    fontSize: 10,
    letterSpacing: "0.15em",
    textTransform: "uppercase",
    color: "var(--c-muted)",
    marginBottom: 6,
  };

  return (
    <section
      id={id}
      style={{
        background: "var(--c-bg)",
        padding: "72px 0",
        borderTop: "1px solid var(--c-border)",
      }}
    >
      <div className="container-custom">
        <div style={{ maxWidth: 640, margin: "0 auto" }}>
          {/* Header */}
          <div style={{ marginBottom: 28 }}>
            <div
              style={{
                fontFamily: "var(--font-inconsolata), monospace",
                fontSize: 10,
                letterSpacing: "0.22em",
                textTransform: "uppercase",
                color: "var(--c-gold)",
                display: "flex",
                alignItems: "center",
                gap: 14,
                marginBottom: 10,
              }}
            >
              {t.sectionLabel}
              <span
                style={{
                  flex: 1,
                  height: 1,
                  background: "var(--c-border)",
                  display: "block",
                }}
              />
            </div>
            <h2
              style={{
                fontFamily: "var(--font-playfair), serif",
                fontWeight: 700,
                fontSize: "clamp(26px, 4vw, 38px)",
                letterSpacing: "-0.02em",
                color: "var(--c-heading)",
                marginBottom: 6,
              }}
            >
              {t.h2}
            </h2>
            <p
              style={{
                fontFamily: "var(--font-instrument-sans), sans-serif",
                fontSize: 13,
                color: "var(--c-muted)",
                lineHeight: 1.6,
              }}
            >
              {t.subtitle}
            </p>
          </div>

          {status === "success" ? (
            <div
              style={{
                background: "var(--c-card)",
                border: "1px solid rgba(200,169,110,0.35)",
                borderRadius: 10,
                padding: 22,
                fontFamily: "var(--font-instrument-sans), sans-serif",
                fontSize: 14,
                color: "var(--c-text)",
                textAlign: "center",
              }}
            >
              {t.success}
            </div>
          ) : (
            <form
              onSubmit={handleSubmit}
              style={{
                background: "var(--c-card)",
                border: "1px solid var(--c-border)",
                borderRadius: 10,
                padding: 22,
                display: "flex",
                flexDirection: "column",
                gap: 16,
              }}
            >
              <div>
                <label style={labelStyle}>{t.labels.name}</label>
                <input
                  type="text"
                  required
                  maxLength={120}
                  value={name}
                  onChange={(e) => setName(e.target.value)}
                  style={inputStyle}
                />
              </div>

              <div>
                <label style={labelStyle}>{t.labels.business}</label>
                <input
                  type="text"
                  required
                  maxLength={200}
                  value={business}
                  onChange={(e) => setBusiness(e.target.value)}
                  placeholder={t.placeholders.business}
                  style={inputStyle}
                />
              </div>

              <div>
                <label style={labelStyle}>{t.labels.need}</label>
                <select
                  value={need}
                  onChange={(e) => setNeed(e.target.value)}
                  style={inputStyle}
                >
                  {t.needOptions.map((o) => (
                    <option key={o.v} value={o.v}>
                      {o.l}
                    </option>
                  ))}
                </select>
              </div>

              <div>
                <label style={labelStyle}>{t.labels.budget}</label>
                <select
                  value={budget}
                  onChange={(e) => setBudget(e.target.value)}
                  style={inputStyle}
                >
                  {t.budgetOptions.map((o) => (
                    <option key={o.v} value={o.v}>
                      {o.l}
                    </option>
                  ))}
                </select>
              </div>

              <div>
                <label style={labelStyle}>{t.labels.contactMethod}</label>
                <div
                  className="flex flex-wrap gap-2"
                  style={{ marginTop: 2 }}
                >
                  {t.contactOptions.map((o) => {
                    const active = contactMethod === o.v;
                    return (
                      <button
                        type="button"
                        key={o.v}
                        onClick={() =>
                          setContactMethod(
                            o.v as "telegram" | "whatsapp" | "email",
                          )
                        }
                        style={{
                          fontFamily:
                            "var(--font-instrument-sans), sans-serif",
                          fontSize: 12,
                          fontWeight: 600,
                          padding: "8px 14px",
                          borderRadius: 5,
                          background: active
                            ? "rgba(200,169,110,0.12)"
                            : "transparent",
                          border: active
                            ? "1px solid rgba(200,169,110,0.5)"
                            : "1px solid var(--c-border)",
                          color: active ? "var(--c-gold)" : "var(--c-text2)",
                          cursor: "pointer",
                        }}
                      >
                        {o.l}
                      </button>
                    );
                  })}
                </div>
              </div>

              <div>
                <label style={labelStyle}>{t.labels.contactInfo}</label>
                <input
                  type="text"
                  required
                  maxLength={200}
                  value={contactInfo}
                  onChange={(e) => setContactInfo(e.target.value)}
                  placeholder={contactPlaceholder}
                  style={inputStyle}
                />
              </div>

              {status === "error" && (
                <div
                  style={{
                    fontFamily: "var(--font-instrument-sans), sans-serif",
                    fontSize: 12,
                    color: "#e88",
                  }}
                >
                  {t.error}
                </div>
              )}

              <button
                type="submit"
                disabled={status === "pending"}
                style={{
                  background: "var(--c-gold)",
                  color: "var(--c-bg)",
                  fontFamily: "var(--font-instrument-sans), sans-serif",
                  fontWeight: 600,
                  fontSize: 13,
                  letterSpacing: "0.04em",
                  padding: "12px 24px",
                  borderRadius: 5,
                  border: "none",
                  cursor: status === "pending" ? "wait" : "pointer",
                  opacity: status === "pending" ? 0.7 : 1,
                  alignSelf: "flex-start",
                }}
              >
                {status === "pending" ? t.sending : t.submit}
              </button>
            </form>
          )}
        </div>
      </div>
    </section>
  );
}
