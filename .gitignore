# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# npm cache
.npm-cache/

# claude
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The example file documents TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID for the
# next deployer and contains no secrets, but `.env*` was swallowing it too.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
